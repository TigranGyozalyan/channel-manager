{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read(src/test/java/**)",
      "Read(src/main/java/**)",
      "Edit(src/test/java/**)",
      "Edit(src/main/java/**)",
      "Bash(./mvnw clean compile)",
      "Bash(./mvnw clean compile *)",
      "Bash(./mvnw test)",
      "Bash(./mvnw test *)",
      "Bash(./mvnw package)",
      "Bash(./mvnw package *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run build)",
      "Bash(npm run build *)",
      "Bash(npm run build-js)",
      "Bash(npm run build-dev)",
      "Bash(npm run watch-dev)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git blame *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(jfr print *)",
      "Bash(jfr summary *)",
      "Bash(node .claude/skills/performance-analysis/scripts/*)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ..)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -df *)",
      "Bash(git clean -fx *)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git restore . *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.git/**)",
      "Edit(**/credentials*)",
      "Edit(**/secret*)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
